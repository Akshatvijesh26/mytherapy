<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar with back and save actions -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_medicine"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back"
        app:title="@string/title_add_medicine"
        app:titleTextColor="@color/on_surface"
        app:titleCentered="true"
        app:menu="@menu/menu_add_medicine"
        app:elevation="0dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Card Container for Add Medicine Form -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- SECTION 1: Medicine Photo (Gallery picker or Camera capture) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medicine Photo"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload or take a photo to display in reminder notifications."
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="22dp">

                        <!-- Photo Preview Squircle -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/outline_variant"
                            app:cardBackgroundColor="@color/surface_variant">

                            <ImageView
                                android:id="@+id/iv_photo_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_medication"
                                android:contentDescription="Medicine photo preview" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Buttons: Gallery Picker & Camera Intent -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_select_photo"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                app:icon="@drawable/ic_photo"
                                app:iconTint="@color/primary"
                                app:backgroundTint="@color/primary_container"
                                android:textColor="@color/primary"
                                app:cornerRadius="22dp"
                                android:text="Choose from Gallery"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:tag="choose_photo_button" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_take_photo"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                app:icon="@drawable/ic_camera"
                                app:iconTint="@color/on_surface_variant"
                                android:textColor="@color/on_surface"
                                app:cornerRadius="22dp"
                                app:strokeColor="@color/outline_variant"
                                android:text="Take with Camera"
                                android:textSize="13sp"
                                android:tag="take_photo_button" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SECTION 2: Medicine Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_medicine_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="@string/hint_medicine_name"
                        app:startIconDrawable="@drawable/ic_medication"
                        app:startIconTint="@color/on_surface_variant"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_medicine_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/on_surface"
                            android:tag="medicine_name_input" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- SECTION 3: How Many Times in a Day (Dropdown) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How many times in a day"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_frequency_dropdown"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="Daily frequency"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <AutoCompleteTextView
                            android:id="@+id/actv_frequency_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="1 time a day"
                            android:textColor="@color/on_surface"
                            android:tag="frequency_dropdown" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- SECTION 4: Customizable Dose Reminder Times (Prominent Position) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reminder Times"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_time_slot"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            app:cornerRadius="22dp"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/primary"
                            app:iconPadding="6dp"
                            android:text="+ Add Custom Time"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:tag="btn_add_time_slot" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap any time pill to pick exact time, or tap '+ Add Custom Time' to add more reminder times:"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Container where separate dose time pickers are dynamically or preset managed -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/outline_variant"
                        app:cardBackgroundColor="@color/surface_variant">

                        <LinearLayout
                            android:id="@+id/container_dose_times"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 5: Quick Preset Time Slots (Morning, Afternoon, Night) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Slots"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select the parts of the day when this dose is due:"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/outline_variant"
                        app:cardBackgroundColor="@color/surface_variant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <!-- Morning Checkbox -->
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cb_slot_morning"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Morning (e.g. 08:00 AM)"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary"
                                android:tag="checkbox_morning" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/outline_variant" />

                            <!-- Afternoon Checkbox -->
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cb_slot_afternoon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Afternoon (e.g. 01:00 PM)"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary"
                                android:tag="checkbox_afternoon" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/outline_variant" />

                            <!-- Night Checkbox -->
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cb_slot_night"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Night (e.g. 08:00 PM)"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary"
                                android:tag="checkbox_night" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 5: Timing Relation (Radio buttons: Before Eat vs After Eat) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Timing Relation"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Should the dose be taken before or after a meal?"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rg_timing_relation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_timing_before"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Before Eat"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            app:buttonTint="@color/primary"
                            android:tag="radio_before_eat" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_timing_after"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="After Eat"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            app:buttonTint="@color/primary"
                            android:tag="radio_after_eat" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Persistent Bottom Bar with Save Button -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/outline_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_medicine"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Medicine &amp; Set Reminder"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/on_primary"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            android:tag="save_medicine_button" />
    </LinearLayout>
</LinearLayout>
